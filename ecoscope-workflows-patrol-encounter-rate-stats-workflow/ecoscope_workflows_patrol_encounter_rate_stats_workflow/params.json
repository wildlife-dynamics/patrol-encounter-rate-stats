{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Workflow Details"
    },
    "er_client_name": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/EarthRangerConnection",
          "description": "Select one of your configured data sources.",
          "title": ""
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Data Source"
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "description": "The start time",
          "format": "date-time",
          "title": "Since",
          "type": "string"
        },
        "until": {
          "description": "The end time",
          "format": "date-time",
          "title": "Until",
          "type": "string"
        },
        "timezone": {
          "$ref": "#/$defs/TimezoneInfo",
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Time Range"
    },
    "er_params": {
      "additionalProperties": false,
      "properties": {
        "patrol_types": {
          "description": "Specify the patrol type(s) to analyze (optional). Leave empty to analyze all patrol types.",
          "items": {
            "type": "string"
          },
          "title": "Patrol Types",
          "type": "array"
        },
        "event_types": {
          "description": "Specify the event type(s) to analyze (optional). Leave this section empty to analyze all event types.",
          "items": {
            "type": "string"
          },
          "title": "Event Types",
          "type": "array"
        },
        "status": {
          "default": [
            "done"
          ],
          "description": "Choose to analyze patrols with a certain status. If left empty, patrols of all status will be analyzed",
          "ecoscope:advanced": true,
          "items": {
            "type": "string",
            "oneOf": [
              {
                "const": "active",
                "title": "Active"
              },
              {
                "const": "overdue",
                "title": "Overdue"
              },
              {
                "const": "done",
                "title": "Done"
              },
              {
                "const": "cancelled",
                "title": "Cancelled"
              }
            ]
          },
          "title": "Patrol Status",
          "type": "array",
          "uniqueItems": true
        },
        "event_states": {
          "default": null,
          "description": "Choose to analyze events with a certain state. If left empty, events of all states will be analyzed",
          "ecoscope:advanced": true,
          "items": {
            "type": "string",
            "oneOf": [
              {
                "const": "new",
                "title": "New"
              },
              {
                "const": "active",
                "title": "Active"
              },
              {
                "const": "resolved",
                "title": "Resolved"
              },
              {
                "const": "review",
                "title": "Review"
              }
            ]
          },
          "title": "Event State",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "patrol_types",
        "event_types"
      ],
      "type": "object",
      "title": "Patrol and Event Params"
    },
    "patrol_filters": {
      "additionalProperties": false,
      "properties": {
        "bounding_box": {
          "$ref": "#/$defs/BoundingBox",
          "default": {
            "min_y": -90.0,
            "max_y": 90.0,
            "min_x": -180.0,
            "max_x": 180.0
          },
          "description": "Only include observations/events inside this bounding box.",
          "ecoscope:advanced": true,
          "title": "Bounding Box"
        },
        "filter_point_coords": {
          "default": [
            {
              "y": 90.0,
              "x": 180.0
            },
            {
              "y": 0.0,
              "x": 0.0
            },
            {
              "y": 1.0,
              "x": 1.0
            }
          ],
          "description": "Exclude observations/events at these exact coordinates.",
          "ecoscope:advanced": true,
          "items": {
            "$ref": "#/$defs/Coordinate"
          },
          "title": "Filter Exact Point Coordinates",
          "type": "array"
        },
        "trajectory_segment_filter": {
          "$ref": "#/$defs/TrajectorySegmentFilter",
          "default": {
            "min_length_meters": 0.001,
            "max_length_meters": 100000,
            "min_time_secs": 1,
            "max_time_secs": 172800,
            "min_speed_kmhr": 0.01,
            "max_speed_kmhr": 500
          },
          "description": "Drop trajectory segments outside these length/time/speed bounds.",
          "ecoscope:advanced": true,
          "title": "Trajectory Filter"
        }
      },
      "type": "object",
      "required": [],
      "title": "Filters"
    },
    "groupers": {
      "additionalProperties": false,
      "properties": {
        "groupers": {
          "default": null,
          "description": "            Specify how the data should be grouped to create the views for your dashboard.\n            This field is optional; if left blank, all the data will appear in a single view.\n            ",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ValueGrouper"
              },
              {
                "$ref": "#/$defs/TemporalGrouper"
              },
              {
                "$ref": "#/$defs/SpatialGrouper"
              }
            ],
            "title": "Group by"
          },
          "title": " ",
          "type": "array"
        }
      },
      "type": "object",
      "required": [],
      "title": "Group Data"
    },
    "summary_groupers": {
      "additionalProperties": false,
      "properties": {
        "groupers": {
          "default": null,
          "description": "            Specify how the data should be grouped to create the views for your dashboard.\n            This field is optional; if left blank, all the data will appear in a single view.\n            ",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ValueGrouper"
              },
              {
                "$ref": "#/$defs/TemporalGrouper"
              },
              {
                "$ref": "#/$defs/SpatialGrouper"
              }
            ],
            "title": "Group by"
          },
          "title": " ",
          "type": "array"
        }
      },
      "type": "object",
      "required": [],
      "title": "Summarize by"
    },
    "summary_metrics": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "allOf": [
            {
              "if": {
                "properties": {
                  "count_or_sum": {
                    "const": "Sum of Column"
                  }
                }
              },
              "then": {
                "properties": {
                  "column": {
                    "type": "string",
                    "title": "Event Field to Sum",
                    "description": "Event details field whose values are totaled, using the field title shown in EarthRanger (for example \"Number of Animals\")."
                  }
                }
              }
            }
          ],
          "default": null,
          "properties": {
            "count_or_sum": {
              "type": "string",
              "title": "Measure Events By",
              "default": "Count",
              "oneOf": [
                {
                  "const": "Count",
                  "title": "Number of Events"
                },
                {
                  "const": "Sum of Column",
                  "title": "Sum of an Event Field"
                }
              ]
            }
          },
          "title": "",
          "type": "object"
        },
        "metrics": {
          "default": [
            {
              "metric": "total_encounter"
            },
            {
              "metric": "total_duration",
              "unit": "h"
            },
            {
              "metric": "encounters_per_duration",
              "unit": "h"
            },
            {
              "metric": "total_distance",
              "unit": "km"
            },
            {
              "metric": "encounters_per_distance",
              "unit": "km"
            }
          ],
          "description": "Metrics shown as columns in the encounter rate table. Add or remove rows to customize.",
          "items": {
            "discriminator": {
              "mapping": {
                "active_duration": "#/$defs/ActiveDurationMetric",
                "area_covered_merged": "#/$defs/MergedAreaCoveredMetric",
                "area_covered_unmerged": "#/$defs/UnmergedAreaCoveredMetric",
                "custom": "#/$defs/CustomMetric",
                "elapsed_duration": "#/$defs/ElapsedDurationMetric",
                "encounters_per_distance": "#/$defs/EncountersPerDistanceMetric",
                "encounters_per_duration": "#/$defs/EncountersPerDurationMetric",
                "encounters_per_patrol": "#/$defs/EncountersPerPatrolMetric",
                "encounters_per_patrol_day": "#/$defs/EncountersPerPatrolDayMetric",
                "leg_count": "#/$defs/LegCountMetric",
                "member_days": "#/$defs/MemberDaysMetric",
                "patrol_count": "#/$defs/PatrolCountMetric",
                "patrol_days": "#/$defs/PatrolDaysMetric",
                "total_distance": "#/$defs/TotalDistanceMetric",
                "total_duration": "#/$defs/TotalDurationMetric",
                "total_encounter": "#/$defs/TotalEncounterMetric",
                "total_events": "#/$defs/TotalEventsMetric"
              },
              "propertyName": "metric"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ActiveDurationMetric"
              },
              {
                "$ref": "#/$defs/MergedAreaCoveredMetric"
              },
              {
                "$ref": "#/$defs/UnmergedAreaCoveredMetric"
              },
              {
                "$ref": "#/$defs/CustomMetric"
              },
              {
                "$ref": "#/$defs/ElapsedDurationMetric"
              },
              {
                "$ref": "#/$defs/EncountersPerDistanceMetric"
              },
              {
                "$ref": "#/$defs/EncountersPerDurationMetric"
              },
              {
                "$ref": "#/$defs/EncountersPerPatrolMetric"
              },
              {
                "$ref": "#/$defs/EncountersPerPatrolDayMetric"
              },
              {
                "$ref": "#/$defs/LegCountMetric"
              },
              {
                "$ref": "#/$defs/MemberDaysMetric"
              },
              {
                "$ref": "#/$defs/PatrolCountMetric"
              },
              {
                "$ref": "#/$defs/PatrolDaysMetric"
              },
              {
                "$ref": "#/$defs/TotalDistanceMetric"
              },
              {
                "$ref": "#/$defs/TotalDurationMetric"
              },
              {
                "$ref": "#/$defs/TotalEncounterMetric"
              },
              {
                "$ref": "#/$defs/TotalEventsMetric"
              }
            ]
          },
          "title": "Metrics",
          "type": "array"
        }
      },
      "type": "object",
      "required": [],
      "title": "Metrics"
    }
  },
  "$defs": {
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    },
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "BoundingBox": {
      "properties": {
        "min_y": {
          "default": -90.0,
          "ecoscope:advanced": true,
          "title": "Min Latitude",
          "type": "number"
        },
        "max_y": {
          "default": 90.0,
          "ecoscope:advanced": true,
          "title": "Max Latitude",
          "type": "number"
        },
        "min_x": {
          "default": -180.0,
          "ecoscope:advanced": true,
          "title": "Min Longitude",
          "type": "number"
        },
        "max_x": {
          "default": 180.0,
          "ecoscope:advanced": true,
          "title": "Max Longitude",
          "type": "number"
        }
      },
      "title": "BoundingBox",
      "type": "object"
    },
    "Coordinate": {
      "properties": {
        "y": {
          "description": "Example -0.15293",
          "title": "Latitude",
          "type": "number"
        },
        "x": {
          "description": "Example 37.30906",
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "y",
        "x"
      ],
      "title": "Coordinate",
      "type": "object"
    },
    "TrajectorySegmentFilter": {
      "properties": {
        "min_length_meters": {
          "default": 0.001,
          "ecoscope:advanced": true,
          "minimum": 0.001,
          "title": "Minimum Segment Length (Meters)",
          "type": "number"
        },
        "max_length_meters": {
          "default": 100000,
          "ecoscope:advanced": true,
          "exclusiveMinimum": 0.001,
          "title": "Maximum Segment Length (Meters)",
          "type": "number"
        },
        "min_time_secs": {
          "default": 1,
          "ecoscope:advanced": true,
          "minimum": 1,
          "title": "Minimum Segment Duration (Seconds)",
          "type": "number"
        },
        "max_time_secs": {
          "default": 172800,
          "ecoscope:advanced": true,
          "exclusiveMinimum": 1,
          "title": "Maximum Segment Duration (Seconds)",
          "type": "number"
        },
        "min_speed_kmhr": {
          "default": 0.01,
          "ecoscope:advanced": true,
          "exclusiveMinimum": 0.001,
          "title": "Minimum Segment Speed (Kilometers per Hour)",
          "type": "number"
        },
        "max_speed_kmhr": {
          "default": 500,
          "ecoscope:advanced": true,
          "exclusiveMinimum": 0.001,
          "title": "Maximum Segment Speed (Kilometers per Hour)",
          "type": "number"
        }
      },
      "title": "TrajectorySegmentFilter",
      "type": "object"
    },
    "SpatialGrouper": {
      "properties": {
        "spatial_index_name": {
          "title": "Spatial Regions",
          "type": "string"
        }
      },
      "required": [
        "spatial_index_name"
      ],
      "title": "Spatial",
      "type": "object"
    },
    "TemporalGrouper": {
      "properties": {
        "temporal_index": {
          "oneOf": [
            {
              "const": "%Y",
              "title": "Year (example: 2024)"
            },
            {
              "const": "%B",
              "title": "Month (example: September)"
            },
            {
              "const": "%Y-%m",
              "title": "Year and Month (example: 2023-01)"
            },
            {
              "const": "%j",
              "title": "Day of the year as a number (example: 365)"
            },
            {
              "const": "%d",
              "title": "Day of the month as a number (example: 31)"
            },
            {
              "const": "%A",
              "title": "Day of the week (example: Sunday)"
            },
            {
              "const": "%H",
              "title": "Hour (24-hour clock) as number (example: 22)"
            },
            {
              "const": "%Y-%m-%d",
              "title": "Date (example: 2025-01-31)"
            }
          ],
          "title": "Time",
          "type": "string"
        }
      },
      "required": [
        "temporal_index"
      ],
      "title": "Time",
      "type": "object"
    },
    "ValueGrouper": {
      "properties": {
        "index_name": {
          "title": "Category",
          "type": "string"
        }
      },
      "required": [
        "index_name"
      ],
      "title": "Category",
      "type": "object"
    },
    "ActiveDurationMetric": {
      "properties": {
        "metric": {
          "const": "active_duration",
          "default": "active_duration",
          "title": "Metric",
          "type": "string"
        },
        "unit": {
          "default": "h",
          "oneOf": [
            {
              "const": "h",
              "title": "Hours (h)"
            },
            {
              "const": "d",
              "title": "Days (d)"
            }
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "title": "Active Duration",
      "type": "object"
    },
    "CustomMetric": {
      "allOf": [
        {
          "if": {
            "properties": {
              "convert_units": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "original_unit": {
                "oneOf": [
                  {
                    "const": "m",
                    "title": "Meters (m)"
                  },
                  {
                    "const": "km",
                    "title": "Kilometers (km)"
                  },
                  {
                    "const": "m\u00b2",
                    "title": "Square Meters (m\u00b2)"
                  },
                  {
                    "const": "km\u00b2",
                    "title": "Square Kilometers (km\u00b2)"
                  },
                  {
                    "const": "s",
                    "title": "Seconds (s)"
                  },
                  {
                    "const": "h",
                    "title": "Hours (h)"
                  },
                  {
                    "const": "d",
                    "title": "Days (d)"
                  },
                  {
                    "const": "m/s",
                    "title": "Meters per Second (m/s)"
                  },
                  {
                    "const": "km/h",
                    "title": "Kilometers per Hour (km/h)"
                  },
                  {
                    "const": "%",
                    "title": "Percent (%)"
                  }
                ],
                "title": "Original Unit",
                "type": "string"
              },
              "new_unit": {
                "oneOf": [
                  {
                    "const": "m",
                    "title": "Meters (m)"
                  },
                  {
                    "const": "km",
                    "title": "Kilometers (km)"
                  },
                  {
                    "const": "m\u00b2",
                    "title": "Square Meters (m\u00b2)"
                  },
                  {
                    "const": "km\u00b2",
                    "title": "Square Kilometers (km\u00b2)"
                  },
                  {
                    "const": "s",
                    "title": "Seconds (s)"
                  },
                  {
                    "const": "h",
                    "title": "Hours (h)"
                  },
                  {
                    "const": "d",
                    "title": "Days (d)"
                  },
                  {
                    "const": "m/s",
                    "title": "Meters per Second (m/s)"
                  },
                  {
                    "const": "km/h",
                    "title": "Kilometers per Hour (km/h)"
                  },
                  {
                    "const": "%",
                    "title": "Percent (%)"
                  }
                ],
                "title": "New Unit",
                "type": "string"
              }
            }
          }
        }
      ],
      "description": "Define your own metric: pick a column and statistic, with optional unit conversion.",
      "properties": {
        "display_name": {
          "description": "Column header shown in the summary table.",
          "title": "Display Name",
          "type": "string"
        },
        "aggregator": {
          "enum": [
            "sum",
            "count",
            "min",
            "max",
            "mean",
            "nunique",
            "median"
          ],
          "title": "Statistic",
          "type": "string"
        },
        "column": {
          "description": "Column to aggregate.",
          "title": "Column",
          "type": "string"
        },
        "decimal_places": {
          "default": 2,
          "title": "Decimal Places",
          "type": "integer"
        },
        "convert_units": {
          "default": false,
          "title": "Convert Units",
          "type": "boolean"
        },
        "metric": {
          "const": "custom",
          "default": "custom",
          "title": "Metric",
          "type": "string"
        }
      },
      "required": [
        "display_name",
        "aggregator",
        "column"
      ],
      "title": "Custom",
      "type": "object"
    },
    "ElapsedDurationMetric": {
      "properties": {
        "metric": {
          "const": "elapsed_duration",
          "default": "elapsed_duration",
          "title": "Metric",
          "type": "string"
        },
        "unit": {
          "default": "h",
          "oneOf": [
            {
              "const": "h",
              "title": "Hours (h)"
            },
            {
              "const": "d",
              "title": "Days (d)"
            }
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "title": "Elapsed Duration",
      "type": "object"
    },
    "EncountersPerDistanceMetric": {
      "properties": {
        "metric": {
          "const": "encounters_per_distance",
          "default": "encounters_per_distance",
          "title": "Metric",
          "type": "string"
        },
        "unit": {
          "default": "km",
          "oneOf": [
            {
              "const": "km",
              "title": "Kilometers (km)"
            },
            {
              "const": "m",
              "title": "Meters (m)"
            }
          ],
          "title": "Unit",
          "type": "string"
        },
        "aggregate_column": {
          "default": "",
          "description": "Event details field whose values are totaled for this metric, using the field title shown in EarthRanger (for example \"Number of Animals\"). Leave blank to use the task-level Event Field to Sum.",
          "title": "Event Field to Sum",
          "type": "string"
        }
      },
      "title": "Encounters per Distance",
      "type": "object"
    },
    "EncountersPerDurationMetric": {
      "properties": {
        "metric": {
          "const": "encounters_per_duration",
          "default": "encounters_per_duration",
          "title": "Metric",
          "type": "string"
        },
        "unit": {
          "default": "h",
          "oneOf": [
            {
              "const": "h",
              "title": "Hours (h)"
            },
            {
              "const": "d",
              "title": "Days (d)"
            }
          ],
          "title": "Unit",
          "type": "string"
        },
        "aggregate_column": {
          "default": "",
          "description": "Event details field whose values are totaled for this metric, using the field title shown in EarthRanger (for example \"Number of Animals\"). Leave blank to use the task-level Event Field to Sum.",
          "title": "Event Field to Sum",
          "type": "string"
        }
      },
      "title": "Encounters per Duration",
      "type": "object"
    },
    "EncountersPerPatrolDayMetric": {
      "description": "Rate against patrol days \u2014 distinct calendar days with patrol movement\n(nunique segment_start_date, matching PatrolDaysMetric).",
      "properties": {
        "metric": {
          "const": "encounters_per_patrol_day",
          "default": "encounters_per_patrol_day",
          "title": "Metric",
          "type": "string"
        },
        "aggregate_column": {
          "default": "",
          "description": "Event details field whose values are totaled for this metric, using the field title shown in EarthRanger (for example \"Number of Animals\"). Leave blank to use the task-level Event Field to Sum.",
          "title": "Event Field to Sum",
          "type": "string"
        }
      },
      "title": "Encounters per Patrol Day",
      "type": "object"
    },
    "EncountersPerPatrolMetric": {
      "properties": {
        "metric": {
          "const": "encounters_per_patrol",
          "default": "encounters_per_patrol",
          "title": "Metric",
          "type": "string"
        },
        "aggregate_column": {
          "default": "",
          "description": "Event details field whose values are totaled for this metric, using the field title shown in EarthRanger (for example \"Number of Animals\"). Leave blank to use the task-level Event Field to Sum.",
          "title": "Event Field to Sum",
          "type": "string"
        }
      },
      "title": "Encounters per Patrol",
      "type": "object"
    },
    "LegCountMetric": {
